GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-3-flash-preview

# Opcional. Si no se define, Stoko genera una clave local persistente.
# STOKO_SECRET_KEY=clave_local_larga_y_aleatoria
# STOKO_CONFIG_DIR=/ruta/local/configuracion

# Opcional para instalación local/Electron.
# Si no se define, se usa backend/stoko.db para desarrollo.
STOKO_DB_PATH=/ruta/local/stoko.db
# DATABASE_URL=sqlite:////ruta/local/stoko.db
